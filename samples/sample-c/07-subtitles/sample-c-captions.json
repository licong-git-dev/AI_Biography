{
  "sampleId": "sample-c",
  "title": "遇见她以后",
  "fps": 24,
  "captions": [
    {"id": "cap-01", "start": 0.0, "end": 5.0, "text": "有些人出现以后，你才知道自己原来也值得被爱。"},
    {"id": "cap-02", "start": 5.0, "end": 12.0, "text": "最开始见她的时候，我没觉得她会成为我的命运。"},
    {"id": "cap-03", "start": 12.0, "end": 18.0, "text": "后来她来找我学主持，第一次走进我那间毛坯房。"},
    {"id": "cap-04", "start": 18.0, "end": 26.0, "text": "我给她蒸了腊肠和汤包，笨拙得像在交一份人生答卷。"},
    {"id": "cap-05", "start": 26.0, "end": 33.0, "text": "我们一起骑车，从汉口到武昌。"},
    {"id": "cap-06", "start": 33.0, "end": 40.0, "text": "坐轮渡，吃小吃，聊那些谁都不轻易说出口的家庭往事。"},
    {"id": "cap-07", "start": 40.0, "end": 48.0, "text": "她没有拯救我，她只是让我第一次觉得，日子可以被认真地过好。"},
    {"id": "cap-08", "start": 48.0, "end": 56.0, "text": "原来真正的爱情，是让一个人慢慢变亮。", "style": "end-card"}
  ]
}
