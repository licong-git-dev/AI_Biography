{
  "sampleId": "sample-b",
  "title": "那个不说话的男孩",
  "fps": 24,
  "captions": [
    {"id": "cap-01", "start": 0.0, "end": 4.0, "text": "小时候我不爱说话。"},
    {"id": "cap-02", "start": 4.0, "end": 11.0, "text": "因为有些难过，说了也没人懂。"},
    {"id": "cap-03", "start": 11.0, "end": 17.0, "text": "他们都觉得我叛逆。"},
    {"id": "cap-04", "start": 17.0, "end": 24.0, "text": "觉得我不听话，觉得我变坏了。"},
    {"id": "cap-05", "start": 24.0, "end": 32.0, "text": "可我只是太想证明自己。"},
    {"id": "cap-06", "start": 32.0, "end": 40.0, "text": "我看着别的同学坐进小汽车里，看着妈妈骑着旧摩托来接我。"},
    {"id": "cap-07", "start": 40.0, "end": 47.0, "text": "那一刻，我说了一句后来想起来都后悔的话。"},
    {"id": "cap-08", "start": 47.0, "end": 55.0, "text": "我不是不爱她，我只是太羡慕那些完整的家庭。"},
    {"id": "cap-09", "start": 55.0, "end": 63.0, "text": "后来我才知道，少年时最难的，不是吃苦，而是不知道该向谁开口。", "style": "end-card"}
  ]
}
