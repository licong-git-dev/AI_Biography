{
  "sampleId": "sample-a",
  "title": "西山的灯一直亮着",
  "fps": 24,
  "captions": [
    {
      "id": "cap-01",
      "start": 0.0,
      "end": 5.0,
      "text": "三岁那年，我第一次知道，家也会分成两个。"
    },
    {
      "id": "cap-02",
      "start": 5.0,
      "end": 11.0,
      "text": "可我最先记住的，不是离开。"
    },
    {
      "id": "cap-03",
      "start": 11.0,
      "end": 19.0,
      "text": "是西山脚下的清晨，是爷爷牵着我的手去吃热干面。"
    },
    {
      "id": "cap-04",
      "start": 19.0,
      "end": 26.0,
      "text": "是奶奶拍着我的背，哼着我听不懂的小调。"
    },
    {
      "id": "cap-05",
      "start": 26.0,
      "end": 34.0,
      "text": "后来，父亲提着行李走出了那扇门。"
    },
    {
      "id": "cap-06",
      "start": 34.0,
      "end": 40.0,
      "text": "我站在门口，伸出手，却不知道该追谁。"
    },
    {
      "id": "cap-07",
      "start": 40.0,
      "end": 50.0,
      "text": "从那以后，我开始在两个家之间来回。公交车开过乡村，也开进城市。"
    },
    {
      "id": "cap-08",
      "start": 50.0,
      "end": 60.0,
      "text": "奶奶把一包花生塞到我手里，站在村口一直挥手。"
    },
    {
      "id": "cap-09",
      "start": 60.0,
      "end": 68.0,
      "text": "我后来才明白，一个孩子最先学会的，往往不是长大，而是忍住想哭。",
      "style": "end-card"
    }
  ]
}
